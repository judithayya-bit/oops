class CurrencyConverter:
    def __init__(self):
        # Example exchange rates relative to USD
        self.rates = {
            "USD": 1.0,
            "EUR": 0.92,
            "GBP": 0.78,
            "INR": 83.0,
            "JPY": 149.0
        }

    def convert(self, amount, from_currency, to_currency):
        from_currency = from_currency.upper()
        to_currency = to_currency.upper()

        if from_currency not in self.rates:
            raise ValueError("Invalid source currency")

        if to_currency not in self.rates:
            raise ValueError("Invalid target currency")

        # Convert source currency → USD → target currency
        amount_in_usd = amount / self.rates[from_currency]
        converted_amount = amount_in_usd * self.rates[to_currency]

        return converted_amount
from currency_converter import CurrencyConverter

converter = CurrencyConverter()

amount = float(input("Enter amount: "))
from_currency = input("From currency (USD/EUR/GBP/INR/JPY): ")
to_currency = input("To currency (USD/EUR/GBP/INR/JPY): ")

try:
    result = converter.convert(amount, from_currency, to_currency)
    print(f"{amount} {from_currency.upper()} = "
          f"{result:.2f} {to_currency.upper()}")
except ValueError as e:
    print(e)
