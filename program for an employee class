class Employee {
    String name;
    double salary;

    Employee(String name, double salary) {
        this.name = name;
        this.salary = salary;
    }

    public static void main(String[] args) {
        Employee e1 = new Employee("Arun", 25000);
        Employee e2 = new Employee("Bala", 40000);
        Employee e3 = new Employee("Ravi", 30000);

        Employee high = e1;

        if (e2.salary > high.salary)
            high = e2;

        if (e3.salary > high.salary)
            high = e3;

        System.out.println("Highest Salary Employee: " + high.name);
        System.out.println("Salary: " + high.salary);
    }
}
